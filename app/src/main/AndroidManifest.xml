<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissão de internet para chamadas à API SAP OData -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permissão de câmera para leitura de QR Code / código de barras -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Feature de câmera (não obrigatória — app funciona sem câmera) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@null"
        android:label="@string/app_name"
        android:roundIcon="@null"
        android:supportsRtl="true"
        android:theme="@style/Theme.BuscaMaterial"
        android:usesCleartextTraffic="true">

        <!--
            MainActivity é a única activity.
            NÃO há intent-filter LAUNCHER — o app não aparece no launcher do dispositivo.
            É lançado exclusivamente via Intent explícita pelo MenuAutomatico.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Sem intent-filter LAUNCHER: ícone não aparece para o usuário final -->
        </activity>

    </application>

</manifest>
